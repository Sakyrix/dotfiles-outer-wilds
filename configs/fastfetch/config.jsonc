{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "~/.config/fastfetch/outerwilds.txt",
    "type": "file",
    "color": {
      "1": "yellow"
    },
    "padding": {
      "top": 1,
      "right": 3
    }
  },
  "display": {
    "color": {
      "keys": "yellow",
      "title": "bright_yellow"
    }
  },
  "modules": [
    "title",
    "separator",
    "os",
    "host",
    "kernel",
    "uptime",
    "packages",
    "de",
    "cpu",
    "gpu",
    "memory"
  ]
}
