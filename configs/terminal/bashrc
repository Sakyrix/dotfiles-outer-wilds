#
# ~/.bashrc
#

# If not running interactively, don't do anything
[[ $- != *i* ]] && return

alias ls='ls --color=auto'
alias grep='grep --color=auto'
PS1='[\u@\h \W]\$ '
eval "$(starship init bash)"
fastfetch

# Alias eza Outer Wilds
alias ls='eza --icons --group-directories-first'
alias ll='eza -la --icons --group-directories-first --git'
alias lt='eza --tree --level=2 --icons'

# Bascule Boost CPU
alias mode-jeu="sudo sh -c 'echo 1 > /sys/devices/system/cpu/cpufreq/boost' && echo '[+] Mode Jeu activé : Boost CPU actif'"
alias mode-calme="sudo sh -c 'echo 0 > /sys/devices/system/cpu/cpufreq/boost' && echo '[-] Mode Calme activé : Boost CPU coupé'"

#connection vpn
alias vpniut='sudo openfortivpn'
