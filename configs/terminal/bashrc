#
# ~/.bashrc
#

# If not running interactively, don't do anything
[[ $- != *i* ]] && return

alias grep='grep --color=auto'

# ls : eza avec icônes si installé, sinon ls classique
if command -v eza >/dev/null 2>&1; then
    alias ls='eza --icons --group-directories-first'
    alias ll='eza -la --icons --group-directories-first --git'
    alias lt='eza --tree --level=2 --icons'
else
    alias ls='ls --color=auto'
    alias ll='ls -la'
fi

# Prompt Starship (prompt classique en secours)
if command -v starship >/dev/null 2>&1; then
    eval "$(starship init bash)"
else
    PS1='[\u@\h \W]\$ '
fi

# Bannière Outer Wilds au lancement du terminal
if command -v fastfetch >/dev/null 2>&1; then
    fastfetch
fi

# Bascule Boost CPU (demande le mot de passe sudo)
_cpu_boost() {
    local f=/sys/devices/system/cpu/cpufreq/boost
    if [ ! -e "$f" ]; then
        echo "[!] Boost CPU indisponible sur cette machine ($f introuvable)"
        return 1
    fi
    echo "$1" | sudo tee "$f" >/dev/null
}
mode-jeu()   { _cpu_boost 1 && echo '[+] Mode Jeu activé : Boost CPU actif'; }
mode-calme() { _cpu_boost 0 && echo '[-] Mode Calme activé : Boost CPU coupé'; }
